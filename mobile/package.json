{
  "name": "mobile",
  "version": "0.1.16",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "node tests/scheduleToast.test.mjs && node tests/rpc.test.mjs && vitest run",
    "test:watch": "vitest",
    "expo:doctor": "npx -y expo-doctor",
    "eas:login": "npx -y eas-cli login",
    "eas:whoami": "npx -y eas-cli whoami",
    "eas:init": "npx -y eas-cli project:init",
    "build:dev": "npx -y eas-cli build --platform android --profile development",
    "build:preview": "npx -y eas-cli build --platform android --profile preview",
    "build:prod": "npx -y eas-cli build --platform android --profile production --clear-cache"
  },
  "dependencies": {
    "@expo-google-fonts/geist": "^0.4.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo/vector-icons": "^15.0.3",
    "expo": "~55.0.26",
    "expo-asset": "~55.0.17",
    "expo-audio": "~55.0.14",
    "expo-background-task": "~55.0.0",
    "expo-build-properties": "~55.0.14",
    "expo-camera": "~55.0.19",
    "expo-clipboard": "~55.0.13",
    "expo-constants": "~55.0.16",
    "expo-font": "~55.0.8",
    "expo-haptics": "~55.0.14",
    "expo-linking": "~55.0.15",
    "expo-local-authentication": "~55.0.14",
    "expo-notifications": "~55.0.23",
    "expo-router": "~55.0.16",
    "expo-secure-store": "~55.0.14",
    "expo-splash-screen": "~55.0.21",
    "expo-status-bar": "~55.0.6",
    "expo-task-manager": "~55.0.16",
    "react": "19.2.0",
    "react-native": "0.83.6",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-worklets": "0.7.4"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "babel-preset-expo": "~55.0.8",
    "jsdom": "^29.1.1",
    "react-dom": "19.2.0",
    "vitest": "^4.1.6"
  },
  "private": true
}
