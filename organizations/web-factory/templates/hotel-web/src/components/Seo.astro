---
// Seo.astro — head SEO infra (FIXED layer; the AI never edits this).
// canonical + hreflang alternates + Open Graph + Twitter + JSON-LD Hotel + robots.
// Fed by site.config + per-page seo override; null contact fields are omitted.
import site from "../config/site";
import { pageCopy } from "../lib/content";

interface Props {
  locale: string;
  title: string;
  description?: string;
  image?: string;
  keywords?: string[];
}
const { locale, title, image, keywords } = Astro.props;
// Per-page LOCALIZED fallback — site.brand.tagline is single-locale, so the
// home copy's localized seo/subtitle wins before it.
const homeCopy = await pageCopy("home", locale);
const brandLine = homeCopy?.seo?.description ?? homeCopy?.hero?.subtitle ?? site.brand.tagline;
const description = Astro.props.description || [title, brandLine].filter(Boolean).join(" — ");

const brandKey = site.brand.name.split(/\s+/).slice(0, 2).join(" ").toLowerCase();
const fullTitle = title.toLowerCase().includes(brandKey) ? title : `${title} · ${site.brand.name}`;
const origin = Astro.site ?? new URL("https://example-hotel.com");
const path = Astro.url.pathname;
const canonical = new URL(path, origin).toString();
const ogImage = image ? new URL(image, origin).toString() : undefined;

// hreflang alternates: swap the leading /<locale>/ segment for each site locale.
const seg = path.split("/"); // ["", "es", "rooms", …]
const swap = (l: string) => {
  const s = [...seg];
  if (s[1] && site.locales.includes(s[1])) s[1] = l;
  else s.splice(1, 0, l);
  return new URL(s.join("/"), origin).toString();
};
const alternates = site.locales.map((l) => ({ lang: l, href: swap(l) }));
const xDefault = swap(site.defaultLocale);

const OG_LOCALE: Record<string, string> = {
  es: "es_ES", en: "en_US", fr: "fr_FR", de: "de_DE",
  it: "it_IT", pt: "pt_PT", nl: "nl_NL", ca: "ca_ES", ru: "ru_RU", "zh-Hans": "zh_CN",
};
const c = site.contact ?? {};
const home = new URL(`/${locale}/`, origin).toString();
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Hotel",
  name: site.brand.name,
  url: home,
  ...(description && { description }),
  ...(ogImage && { image: ogImage }),
  ...(c.address && { address: c.address }),
  ...(c.phone && { telephone: c.phone }),
  ...(c.email && { email: c.email }),
  ...(c.coords && {
    geo: { "@type": "GeoCoordinates", latitude: c.coords.lat, longitude: c.coords.lng },
  }),
  ...(site.social?.length && {
    sameAs: site.social.map((s) => s.href).filter((h) => h && h !== "#"),
  }),
};
---
<title>{fullTitle}</title>
<meta name="description" content={description} />
{keywords?.length ? <meta name="keywords" content={keywords.join(", ")} /> : null}
<link rel="canonical" href={canonical} />
<meta name="robots" content="index, follow" />
{alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
<link rel="alternate" hreflang="x-default" href={xDefault} />

<meta property="og:type" content="website" />
<meta property="og:site_name" content={site.brand.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={OG_LOCALE[locale] ?? locale.replace("-", "_")} />
{ogImage ? <meta property="og:image" content={ogImage} /> : null}
<meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
{ogImage ? <meta name="twitter:image" content={ogImage} /> : null}

<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
