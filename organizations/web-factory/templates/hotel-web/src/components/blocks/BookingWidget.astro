---
// Plugin mount the AI never wires: provider "mirai" mounts @mirai/core's <Finder> (assets + instance injected by BaseLayout); any other provider keeps the inert mock.
import site from "../../config/site";
import { useT } from "../../i18n";
import Button from "../primitives/Button.astro";
interface Props { locale: string; vertical?: boolean; }
const { locale, vertical = false } = Astro.props;
const t = useT(locale);
const mirai = (site.booking?.provider ?? "").toLowerCase() === "mirai";
const fields = site.booking.fields;
const sample: Record<string, string> = {
  checkin: t("booking.checkin"), checkout: t("booking.checkout"),
  guests: t("booking.guests"), rooms: t("booking.rooms"),
};
---
{mirai ? (
  <div id="book" class={`bwm ${vertical ? "v" : ""}`}>
    <div data-mirai-component="finder" data-layout={vertical ? "column" : undefined}></div>
  </div>
) : (
  <div id="book" class={`bw ${vertical ? "v" : ""}`} data-provider={site.booking.provider} data-property={site.booking.propertyId}>
    {fields.map((f) => (
      <label class="field">
        <span class="lbl">{sample[f] ?? f}</span>
        <span class="input">{f === "guests" ? "2" : f === "rooms" ? "1" : "—"}</span>
      </label>
    ))}
    <Button size="lg">{t("booking.search")}</Button>
  </div>
)}
<style>
  .bw { display: flex; gap: 10px; align-items: flex-end; background: var(--color-paper);
    border: 1px solid var(--color-line); border-radius: calc(var(--radius) + 4px);
    padding: 12px; box-shadow: var(--shadow-md); }
  .bw.v { flex-direction: column; align-items: stretch; box-shadow: none; }
  .field { flex: 1; display: flex; flex-direction: column; gap: 5px; min-width: 0; }
  .lbl { font-size: 9.5px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; color: var(--color-muted); }
  .input { height: 30px; display: flex; align-items: center; padding: 0 10px;
    background: var(--color-surface); border: 1px solid var(--color-line);
    border-radius: var(--radius); font-size: 12px; color: var(--color-muted); }
  .bwm { display: flex; justify-content: center; }
  .bwm > :global(*) { max-width: 100%; }
  .bwm.v > :global(*) { width: 100%; }
  .bwm { --mirai-finder-background: var(--color-paper); --mirai-finder-border-radius: var(--radius); }
</style>
