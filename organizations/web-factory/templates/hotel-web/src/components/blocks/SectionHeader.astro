---
import Eyebrow from "../primitives/Eyebrow.astro";
interface Props { eyebrow?: string; title: string; center?: boolean; as?: "h1" | "h2"; }
const { eyebrow, title, center = false, as = "h2" } = Astro.props;
---
<div class={`sh ${center ? "center" : ""}`}>
  {eyebrow && <Eyebrow>{eyebrow}</Eyebrow>}
  {as === "h1" ? <h1>{title}</h1> : <h2>{title}</h2>}
</div>
<style>
  .sh { margin-bottom: 20px; }
  .sh.center { text-align: center; max-width: 560px; margin-inline: auto; }
  .sh :is(h1, h2) { font-size: 26px; margin-top: 8px; }
</style>
