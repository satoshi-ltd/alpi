---
import { useT } from "../../i18n";
import { byLocale } from "../../lib/content";
import SectionHeader from "./SectionHeader.astro";
import Image from "../primitives/Image.astro";
import site from "../../config/site";
interface Props { locale: string; headingLevel?: "h1" | "h2"; }
const { locale, headingLevel = "h2" } = Astro.props;
const t = useT(locale);
const items = await byLocale("amenities", locale);
const v = site.theme;
const editorial = v === "boutique";
const groups = v === "budget" && items.some((e: any) => e.data.category)
  ? [...new Set(items.map((e: any) => e.data.category ?? ""))].map((cat) => ({
      cat, list: items.filter((e: any) => (e.data.category ?? "") === cat),
    }))
  : null;
---
{items.length > 0 && (
<section class="section"><div class="container">
  <SectionHeader eyebrow={t("nav.amenities")} title={t("nav.amenities")} center={!editorial} as={headingLevel} />
  {groups ? (
    <div class="cats">
      {groups.map(({ cat, list }) => (
        <div class="cat">
          {cat && <div class="cat-h">{cat}</div>}
          <div class="checks">
            {list.map((e: any) => (
              <div class="check"><span class="tick">✓</span><span>{e.data.title}</span></div>
            ))}
          </div>
        </div>
      ))}
    </div>
  ) : editorial ? (
    <div class="stack">
      {items.map((e: any, i: number) => (
        <div class={`row ${i % 2 ? "rev" : ""}`}>
          <div class="media"><Image src={e.data.image} alt={e.data.title} ratio="4/3" /></div>
          <div class="copy">
            <span class="num">0{i + 1}</span>
            <h3>{e.data.title}</h3>
            {e.data.description && <p class="muted">{e.data.description}</p>}
          </div>
        </div>
      ))}
    </div>
  ) : (
    <div class="grid">
      {items.map((e: any) => (
        <div class="card">
          <Image src={e.data.image} alt={e.data.title} ratio="4/3" />
          <h3>{e.data.title}</h3>
          {e.data.description && <p class="muted sm">{e.data.description}</p>}
        </div>
      ))}
    </div>
  )}
</div></section>
)}
<style>
  .stack { display: flex; flex-direction: column; gap: var(--space-7); }
  .row { display: flex; gap: 36px; align-items: center; }
  .row.rev { flex-direction: row-reverse; }
  .row .media { flex: 1; } .row .copy { flex: 1; display: flex; flex-direction: column; gap: 10px; }
  .num { font-family: var(--font-head); color: var(--color-accent); }
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-5); }
  .card { display: flex; flex-direction: column; gap: 8px; }
  .sm { font-size: 12.5px; }
  h3 { font-size: 18px; }
  @media (max-width: 720px) { .row, .row.rev { flex-direction: column; } .grid { grid-template-columns: 1fr; } }
  .cats { display: flex; flex-direction: column; gap: 18px; }
  .cat-h { font-weight: 700; font-size: 13px; margin-bottom: 8px; }
  .checks { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
  .check { display: flex; gap: 7px; background: var(--color-surface); border-radius: var(--radius); padding: 8px 10px; font-size: 12.5px; }
  .tick { color: var(--color-accent); font-weight: 700; }
  @media (max-width: 720px) { .checks { grid-template-columns: 1fr; } }
</style>
