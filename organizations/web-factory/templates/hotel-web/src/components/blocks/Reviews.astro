---
import { useT } from "../../i18n";
import { byLocale } from "../../lib/content";
import SectionHeader from "./SectionHeader.astro";
import Stars from "../primitives/Stars.astro";
import site from "../../config/site";
interface Props { locale: string; }
const { locale } = Astro.props;
const t = useT(locale);
const items = await byLocale("testimonials", locale);
const flat = site.theme !== "boutique";
---
{items.length > 0 && (
<section class="section"><div class="container">
  <SectionHeader eyebrow={t("nav.about")} title={t("section.reviews")} center />
  <div class="grid">
    {items.slice(0, 3).map((e: any) => (
      <div class={`card ${flat ? "flat" : ""}`}>
        <Stars n={e.data.rating} />
        <p class="quote">“{e.data.quote}”</p>
        <span class="author muted">{e.data.author}</span>
      </div>
    ))}
  </div>
</div></section>
)}
<style>
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-5); }
  .card { display: flex; flex-direction: column; gap: 10px; border-radius: var(--radius); padding: 20px; border: 1px solid var(--color-line); }
  .card.flat { background: var(--color-surface); border: none; }
  .quote { font-family: var(--font-head); font-size: 16px; line-height: 1.4; color: var(--color-ink); }
  .author { font-size: 12px; font-weight: 600; }
  @media (max-width: 720px) { .grid { grid-template-columns: 1fr; } }
</style>
