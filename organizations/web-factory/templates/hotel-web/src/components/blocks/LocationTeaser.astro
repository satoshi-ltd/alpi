---
import site from "../../config/site";
import { useT } from "../../i18n";
import Image from "../primitives/Image.astro";
import Eyebrow from "../primitives/Eyebrow.astro";
import Badge from "../primitives/Badge.astro";
import Button from "../primitives/Button.astro";
interface Props {
  locale: string; directions?: string; map?: string; boxed?: boolean;
  distances?: { label: string; value: string }[];
}
const { locale, directions, map, boxed = false, distances = [] } = Astro.props;
const t = useT(locale);
const c = site.contact ?? {};
const mapsHref = c.coords
  ? `https://maps.google.com/?q=${c.coords.lat},${c.coords.lng}`
  : c.address
    ? `https://maps.google.com/?q=${encodeURIComponent(c.address)}`
    : null;
---
<section class="section"><div class="container">
  <div class={`row ${boxed ? "boxed" : ""}`}>
    <div class="media"><Image src={map} alt="Map" ratio="16/10" /></div>
    <div class="copy">
      <Eyebrow>{t("nav.location")}</Eyebrow>
      <h2>{t("section.location")}</h2>
      {directions && <p class="muted">{directions}</p>}
      {distances.length > 0 && (
        <div class="chips">{distances.map((d) => <Badge>{`${d.label} ${d.value}`}</Badge>)}</div>
      )}
      {mapsHref && <Button variant="ghost" href={mapsHref}>{t("cta.getDirections")}</Button>}
    </div>
  </div>
</div></section>
<style>
  .row { display: flex; gap: 28px; align-items: stretch; }
  .row.boxed { background: var(--color-surface); border-radius: var(--radius); padding: 16px; }
  .media { flex: 1; } .copy { flex: 1; display: flex; flex-direction: column; gap: 12px; justify-content: center; align-items: flex-start; }
  .copy h2 { font-size: 24px; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  @media (max-width: 720px) { .row { flex-direction: column; } }
</style>
