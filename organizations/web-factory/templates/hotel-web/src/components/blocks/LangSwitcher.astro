---
import site from "../../config/site";
import { useT } from "../../i18n";
interface Props { locale: string; dark?: boolean; }
const { locale, dark = false } = Astro.props;
const t = useT(locale);
// Same-page alternates: swap the locale segment, like Seo's hreflang does.
const seg = Astro.url.pathname.split("/");
const swap = (l: string) => {
  const s = [...seg];
  if (s[1] && site.locales.includes(s[1])) { s[1] = l; return s.join("/") || "/"; }
  return `/${l}/`;
};
---
<details class={`lang ${dark ? "dark" : ""}`}>
  <summary aria-label={t("a11y.languageSwitcher")}>
    <svg width="13" height="13" viewBox="0 0 13 13" fill="none" stroke="currentColor" stroke-width="1.2">
      <circle cx="6.5" cy="6.5" r="5.5" /><path d="M1 6.5h11M6.5 1c1.8 1.5 1.8 9.5 0 11M6.5 1c-1.8 1.5-1.8 9.5 0 11" />
    </svg>
    <span class="cur">{locale.toUpperCase()}</span>
  </summary>
  <div class="menu">
    {site.locales.map((l) => (
      <a href={swap(l)} aria-current={l === locale ? "true" : undefined}>{l.toUpperCase()}</a>
    ))}
  </div>
</details>
<style>
  .lang { position: relative; display: inline-flex; font-size: 11.5px; font-weight: 600; color: var(--color-muted); }
  .lang.dark { color: rgba(255,255,255,.9); }
  summary { display: inline-flex; align-items: center; gap: 5px; cursor: pointer; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  .menu { position: absolute; top: 100%; right: 0; display: none; flex-direction: column;
    background: var(--color-paper); border: 1px solid var(--color-line); border-radius: var(--radius);
    box-shadow: var(--shadow-md); padding: 4px; min-width: 64px; z-index: 30; }
  .lang[open] .menu, .lang:hover .menu { display: flex; }
  .menu a { padding: 6px 10px; font-size: 12px; color: var(--color-ink); }
  .menu a:hover, .menu a[aria-current] { background: var(--color-surface); }
</style>
