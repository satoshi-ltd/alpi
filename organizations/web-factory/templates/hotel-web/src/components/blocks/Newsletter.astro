---
// Honest without a backend: a mailto CTA when the hotel has an email; hidden otherwise.
import site from "../../config/site";
import { useT } from "../../i18n";
interface Props { locale: string; }
const { locale } = Astro.props;
const t = useT(locale);
const email = site.contact?.email;
const mailto = email ? `mailto:${email}?subject=${encodeURIComponent(t("section.newsletter"))}` : null;
---
{mailto && (
<section class="section"><div class="container">
  <div class="band">
    <div class="copy">
      <div class="h">{t("section.newsletter")}</div>
      <div class="sub">{t("section.newsletterSub")}</div>
    </div>
    <a class="cta" href={mailto}>{t("cta.subscribe")}</a>
  </div>
</div></section>
)}
<style>
  .band { background: var(--color-accent); border-radius: var(--radius); padding: 26px 30px;
    display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap; }
  .copy { flex: 1 1 260px; }
  .h { font-family: var(--font-head); font-weight: var(--weight-head); font-size: 22px; color: #fff; }
  .sub { font-size: 13px; color: #fff; opacity: .85; margin-top: 4px; }
  .cta { padding: 12px 24px; background: #fff; color: var(--color-accent);
    font-weight: 700; font-size: 13px; border-radius: var(--radius-btn-eff); }
</style>
