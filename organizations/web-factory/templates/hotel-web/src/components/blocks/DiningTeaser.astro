---
import { useT } from "../../i18n";
import Image from "../primitives/Image.astro";
import Eyebrow from "../primitives/Eyebrow.astro";
import Button from "../primitives/Button.astro";
interface Props { locale: string; title?: string; description?: string; image?: string; reverse?: boolean; }
const { locale, title, description, image, reverse = false } = Astro.props;
const t = useT(locale);
---
{(title || description || image) && (
<section class="section"><div class={`container row ${reverse ? "rev" : ""}`}>
  <div class="media"><Image src={image} alt={title} ratio="4/3" /></div>
  <div class="copy">
    <Eyebrow>{t("nav.dining")}</Eyebrow>
    <h2>{title}</h2>
    {description && <p class="muted">{description}</p>}
    <Button href={`/${locale}/dining`} variant="ghost">{t("cta.exploreDining")}</Button>
  </div>
</div></section>
)}
<style>
  .row { display: flex; gap: 36px; align-items: center; }
  .row.rev { flex-direction: row-reverse; }
  .media { flex: 1; } .copy { flex: 1; display: flex; flex-direction: column; gap: 14px; align-items: flex-start; }
  .copy h2 { font-size: 26px; }
  @media (max-width: 720px) { .row, .row.rev { flex-direction: column; } }
</style>
