---
import site from "../../config/site";
import { useT } from "../../i18n";
import { byLocale, localePath } from "../../lib/content";
interface Props { locale: string; }
const { locale } = Astro.props;
const t = useT(locale);
const legal = (await byLocale("legal", locale)).filter((e: any) => (e.body ?? "").trim().length > 0);
const cols = [
  { title: t("footer.explore"), items: ["rooms", "dining", "amenities", "gallery"] },
  { title: t("footer.visit"), items: ["location", "offers", "blog", "about"] },
];
---
<footer class="ft">
  <div class="container grid">
    <div>
      <div class="logo">{site.brand.logo
        ? <img class="logo-img" src={site.brand.logo} alt={site.brand.name} />
        : site.brand.name}</div>
      <p class="muted addr">
        {site.contact.address}{site.contact.phone ? ` · ${site.contact.phone}` : ""}{site.contact.email ? ` · ${site.contact.email}` : ""}
      </p>
    </div>
    {cols.map((c) => (
      <div>
        <div class="ch">{c.title}</div>
        <div class="links">
          {c.items.filter((i) => site.pages[i] !== false).map((i) => (
            <a href={localePath(locale, i)}>{t(`nav.${i}`)}</a>
          ))}
        </div>
      </div>
    ))}
    {site.social && (
      <div>
        <div class="ch">{t("footer.connect")}</div>
        <div class="links">{site.social.map((s) => <a href={s.href}>{s.label}</a>)}</div>
      </div>
    )}
  </div>
  <div class="container bottom">
    <span>© {new Date().getFullYear()} {site.brand.name}</span>
    {legal.length > 0 && (
      <span class="legal">
        {legal.map((e: any) => <a href={localePath(locale, "legal", String(e.id).split("/").pop().split(".")[0])}>{e.data.title}</a>)}
      </span>
    )}
  </div>
</footer>
<style>
  .ft { margin-top: var(--space-8); border-top: 1px solid var(--color-line);
    background: color-mix(in oklab, var(--color-accent) 6%, var(--color-paper)); padding-block: 32px 24px; }
  .grid { display: grid; grid-template-columns: 1.6fr 1fr 1fr 1fr; gap: 24px; }
  .logo { font-family: var(--font-head); font-weight: var(--weight-head); font-size: 18px;
    letter-spacing: var(--tracking-label); text-transform: var(--case-label, none); margin-bottom: 8px; }
  .addr { font-size: 12px; max-width: 240px; }
  .logo-img { display: block; height: 26px; width: auto; max-width: 180px; }
  .ch { font-size: 11px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; margin-bottom: 10px; }
  .links { display: flex; flex-direction: column; gap: 7px; font-size: 12px; color: var(--color-muted); }
  .bottom { display: flex; justify-content: space-between; font-size: 11px; color: var(--color-muted);
    margin-top: 22px; padding-top: 14px; border-top: 1px solid var(--color-line); }
  .legal { display: flex; gap: 14px; }
  .legal a:hover { color: var(--color-ink); }
  @media (max-width: 720px) { .grid { grid-template-columns: 1fr 1fr; } }
</style>
