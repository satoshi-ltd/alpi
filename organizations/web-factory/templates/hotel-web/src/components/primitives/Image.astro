---
// Image with graceful placeholder. If `src` is missing/relative-and-absent the
// browser shows the tonal placeholder background (accent wash) behind alt text.
interface Props {
  src?: string;
  alt?: string;
  ratio?: string;      // e.g. "16/9", "4/3", "1/1"
  radius?: boolean;    // apply theme radius
  class?: string;
}
const { src, alt = "", ratio = "4/3", radius = true, class: cls = "" } = Astro.props;
---
<div class={`ph ${radius ? "r" : ""} ${cls}`} style={`aspect-ratio:${ratio}`}>
  {src && <img src={src} alt={alt} loading="lazy" onerror="this.style.display='none'" />}
  <slot />
</div>
<style>
  .ph {
    position: relative; overflow: hidden; width: 100%;
    background:
      radial-gradient(120% 85% at 22% 16%, rgba(255,255,255,.34), transparent 58%),
      linear-gradient(118deg,
        color-mix(in oklab, var(--color-accent) 22%, var(--color-paper)),
        color-mix(in oklab, var(--color-ink) 5%, var(--color-paper)) 55%,
        color-mix(in oklab, var(--color-accent) 12%, var(--color-paper)));
  }
  .r { border-radius: var(--radius); }
  img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
</style>
