---
// Button / link styled as a button. variant: solid | ghost. size: sm | md | lg.
interface Props {
  href?: string;
  variant?: "solid" | "ghost";
  size?: "sm" | "md" | "lg";
  full?: boolean;
  class?: string;
}
const { href, variant = "solid", size = "md", full = false, class: cls = "" } = Astro.props;
const Tag = href ? "a" : "button";
---
<Tag href={href} type={href ? undefined : "button"} class={`btn ${variant} ${size} ${full ? "full" : ""} ${cls}`}>
  <slot />
</Tag>
<style>
  .btn {
    display: inline-flex; align-items: center; justify-content: center;
    font-family: var(--font-body); font-weight: 600;
    border-radius: var(--radius-btn-eff); cursor: pointer; white-space: nowrap;
    letter-spacing: var(--tracking-label); text-transform: var(--case-label, none);
    border: 1px solid transparent; transition: opacity .15s ease;
  }
  .btn:hover { opacity: .88; }
  .sm { padding: 7px 14px; font-size: 12px; }
  .md { padding: 10px 20px; font-size: 13px; }
  .lg { padding: 13px 26px; font-size: 14px; }
  .full { width: 100%; }
  .solid { background: var(--color-accent); color: #fff; }
  .ghost { background: transparent; color: var(--color-accent-2); border-color: var(--color-line); }
</style>
