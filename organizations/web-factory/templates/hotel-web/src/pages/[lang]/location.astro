---
import site from "../../config/site";
import { useT } from "../../i18n";
import { pageCopy } from "../../lib/content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionHeader from "../../components/blocks/SectionHeader.astro";
import Image from "../../components/primitives/Image.astro";
import Badge from "../../components/primitives/Badge.astro";
export function getStaticPaths() { return (site.pages?.location === false ? [] : site.locales.map((lang) => ({ params: { lang } }))); }
const { lang } = Astro.params as { lang: string };
const t = useT(lang);
const copy = await pageCopy("home", lang);
const c = site.contact;
const v = site.theme;
const own = await pageCopy("location", lang);
---
<BaseLayout title={own?.seo?.title ?? t("nav.location")} description={own?.seo?.description} locale={lang}>
  <section class="section"><div class="container">
    <SectionHeader eyebrow={t("nav.location")} title={t("section.location")} center as="h1" />
    <div class="map"><Image src={copy?.location?.map} alt="Map" ratio="21/9" /></div>
    <div class="cols">
      <div>
        <h3>{t("cta.getDirections")}</h3>
        {copy?.location?.directions && <p class="muted">{copy.location.directions}</p>}
        {copy?.location?.distances?.length > 0 && (v === "business" ? (
          <div class="ttable">{copy.location.distances.map((d: any) => (
            <div class="trow"><span class="tlbl">{d.label}</span><span class="tval">{d.value}</span></div>
          ))}</div>
        ) : (
          <div class="chips">{copy.location.distances.map((d: any) => <Badge>{`${d.label} ${d.value}`}</Badge>)}</div>
        ))}
      </div>
      <div class="contact">
        <h3>{site.brand.name}</h3>
        {c.address && <p class="muted">{c.address}</p>}
        {c.phone && <p class="muted">{c.phone}</p>}
        {c.email && <p class="muted">{c.email}</p>}
      </div>
    </div>
  </div></section>
</BaseLayout>
<style>
  .map { margin-bottom: 24px; }
  .cols { display: flex; gap: 40px; }
  .cols > * { flex: 1; display: flex; flex-direction: column; gap: 10px; }
  h3 { font-size: 18px; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  @media (max-width: 720px) { .cols { flex-direction: column; } }
  .ttable { border: 1px solid var(--color-line); border-radius: var(--radius); overflow: hidden; margin-top: 6px; }
  .trow { display: flex; justify-content: space-between; padding: 10px 14px; font-size: 13px; }
  .trow + .trow { border-top: 1px solid var(--color-line); }
  .tlbl { font-weight: 600; }
  .tval { color: var(--color-accent); font-weight: 600; }
</style>
