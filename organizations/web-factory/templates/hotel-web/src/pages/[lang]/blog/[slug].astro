---
import site from "../../../config/site";
import { useT } from "../../../i18n";
import { getCollection } from "astro:content";
import { localePath } from "../../../lib/content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Badge from "../../../components/primitives/Badge.astro";
import Image from "../../../components/primitives/Image.astro";

export async function getStaticPaths() {
  if (site.pages?.blog === false) return [];
  // Post files are `<slug>.<lang>.md`; the URL slug is the part before the
  // first dot (Astro's auto `slug` slugifies the dot away — don't use it).
  const all = await getCollection("posts");
  return all.map((p: any) => ({
    params: { lang: p.data.lang, slug: String(p.id).split("/").pop().split(".")[0] },
    props: { post: p },
  }));
}
const { lang } = Astro.params as { lang: string };
const { post } = Astro.props as { post: any };
const t = useT(lang);
const { Content } = await post.render();
---
<BaseLayout title={post.data.title} locale={lang}>
  <article class="section"><div class="container narrow">
    <a class="back muted" href={localePath(lang, "blog")}>← {t("nav.blog")}</a>
    {post.data.category && <Badge>{post.data.category}</Badge>}
    <h1>{post.data.title}</h1>
    {post.data.readingTime && <p class="meta muted">{post.data.readingTime}</p>}
    {post.data.cover && <div class="cover"><Image src={post.data.cover} alt={post.data.title} ratio="16/9" /></div>}
    <div class="prose"><Content /></div>
  </div></article>
</BaseLayout>
<style>
  .narrow { max-width: 680px; margin-inline: auto; }
  .back { display: inline-block; font-size: 12px; margin-bottom: 12px; }
  h1 { font-size: clamp(28px, 4vw, 40px); margin: 10px 0; }
  .meta { font-size: 12px; }
  .cover { margin: 18px 0 24px; }
  .prose { font-size: 16px; line-height: 1.7; color: var(--color-ink); }
  .prose :global(p) { margin: 0 0 1em; }
</style>
