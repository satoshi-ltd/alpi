---
import site from "../../config/site";
import { useT } from "../../i18n";
import { getCollection } from "astro:content";
import { pageCopy } from "../../lib/content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import OfferCards from "../../components/blocks/OfferCards.astro";
// Generate the offers page ONLY when real offers exist — never an empty page.
export async function getStaticPaths() {
  if (site.pages?.offers === false) return [];
  const offers = await getCollection("offers");
  if (offers.length === 0) return [];
  return site.locales.map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params as { lang: string };
const t = useT(lang);
const own = await pageCopy("offers", lang);
---
<BaseLayout title={own?.seo?.title ?? t("nav.offers")} description={own?.seo?.description} locale={lang}>
  <OfferCards locale={lang} headingLevel="h1" />
</BaseLayout>
