---
import site from "../../config/site";
import { useT } from "../../i18n";
import { byLocale, pageCopy } from "../../lib/content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/blocks/Hero.astro";
import SectionHeader from "../../components/blocks/SectionHeader.astro";
import RoomCard from "../../components/blocks/RoomCard.astro";
import AmenityGrid from "../../components/blocks/AmenityGrid.astro";
import ExperienceTiles from "../../components/blocks/ExperienceTiles.astro";
import OfferCards from "../../components/blocks/OfferCards.astro";
import DiningTeaser from "../../components/blocks/DiningTeaser.astro";
import GalleryStrip from "../../components/blocks/GalleryStrip.astro";
import Reviews from "../../components/blocks/Reviews.astro";
import LocationTeaser from "../../components/blocks/LocationTeaser.astro";
import Newsletter from "../../components/blocks/Newsletter.astro";
import Image from "../../components/primitives/Image.astro";

export function getStaticPaths() {
  return site.locales.map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params as { lang: string };
const t = useT(lang);
const copy = await pageCopy("home", lang);
const rooms = await byLocale("rooms", lang);
const v = site.theme;
// Featured first, then the rest — deduped, so a single featured room never fills both slots.
const featured = [
  ...rooms.filter((r: any) => r.data.featured),
  ...rooms.filter((r: any) => !r.data.featured),
].slice(0, v === "boutique" ? 2 : 3);
---
<BaseLayout
  title={copy?.seo?.title ?? copy?.hero?.title ?? site.brand.name}
  description={copy?.seo?.description ?? copy?.intro?.body}
  image={copy?.hero?.image}
  keywords={copy?.seo?.keywords}
  locale={lang}
  hasBooking>
  <Hero locale={lang} eyebrow={copy?.hero?.eyebrow} title={copy?.hero?.title ?? site.brand.name}
        subtitle={copy?.hero?.subtitle} image={copy?.hero?.image} />

  {copy?.intro && (
    <section class="section"><div class="container intro">
      <SectionHeader title={copy.intro.title ?? ""} center />
      {copy.intro.body && <p class="muted lead">{copy.intro.body}</p>}
    </div></section>
  )}

  {/* About strip (boutique/business lead with story) */}
  {copy?.about && (v === "boutique" || v === "business") && (
    <section class="section"><div class="container about">
      <div class="media"><Image src={copy.about.image} alt={copy.about.title} ratio="4/3" /></div>
      <div class="copy">
        {copy.about.eyebrow && <div class="eyebrow">{copy.about.eyebrow}</div>}
        <h2>{copy.about.title}</h2>
        {copy.about.body && <p class="muted">{copy.about.body}</p>}
      </div>
    </div></section>
  )}

  {/* Rooms preview */}
  <section class="section"><div class="container">
    <SectionHeader eyebrow={t("nav.rooms")} title={t("section.rooms")} center={v !== "budget"} />
    <div class={`rooms cols-${v === "boutique" ? 2 : 3}`}>
      {featured.map((r: any) => (
        <RoomCard locale={lang} name={r.data.name} slug={r.data.slug} summary={r.data.summary}
          priceFrom={r.data.priceFrom} currency={r.data.currency} image={r.data.image}
          sizeM2={r.data.sizeM2} bed={r.data.bed} view={r.data.view} />
      ))}
    </div>
  </div></section>

  {/* Resort leads with experiences + packages */}
  {v === "resort" && <ExperienceTiles locale={lang} />}
  {v === "resort" && site.pages.offers !== false && <OfferCards locale={lang} limit={3} />}

  {/* Dining teaser — all except budget */}
  {v !== "budget" && site.pages.dining !== false && (
    <DiningTeaser locale={lang} title={copy?.dining?.title} description={copy?.dining?.description}
      image={copy?.hero?.image} reverse={v === "business"} />
  )}

  {/* Amenities highlight for business */}
  {v === "business" && <AmenityGrid locale={lang} />}

  {/* Gallery + Reviews everywhere */}
  {site.pages.gallery !== false && <GalleryStrip locale={lang} images={copy?.gallery} cols={v === "budget" ? 6 : 4} />}
  <Reviews locale={lang} />

  {/* Location teaser (boutique/budget/resort; business already had about-context) */}
  {v !== "business" && site.pages.location !== false && (
    <LocationTeaser locale={lang} directions={copy?.location?.directions} map={copy?.location?.map} distances={copy?.location?.distances} boxed={v === "budget"} />
  )}

  <Newsletter locale={lang} />
</BaseLayout>

<style>
  .intro { max-width: 640px; margin-inline: auto; text-align: center; }
  .lead { font-size: 16px; }
  .about { display: flex; gap: 36px; align-items: center; }
  .about .media { flex: 1; } .about .copy { flex: 1; display: flex; flex-direction: column; gap: 14px; }
  .about img { width: 100%; border-radius: var(--radius); aspect-ratio: 4/3; object-fit: cover; }
  .about h2 { font-size: 28px; }
  .rooms { display: grid; gap: var(--space-5); }
  .rooms.cols-2 { grid-template-columns: repeat(2, 1fr); }
  .rooms.cols-3 { grid-template-columns: repeat(3, 1fr); }
  @media (max-width: 720px) { .about { flex-direction: column; } .rooms { grid-template-columns: 1fr !important; } }
</style>
