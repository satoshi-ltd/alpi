---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  // Body-less entries build no page: legal text is hotel-supplied verbatim, and a placeholder stub must degrade to "no page" (spec: no text => no pages).
  const all = (await getCollection("legal")).filter((e: any) => (e.body ?? "").trim().length > 0);
  return all.map((e: any) => ({
    params: { lang: e.data.lang, slug: String(e.id).split("/").pop()!.split(".")[0] },
    props: { entry: e },
  }));
}
const { lang } = Astro.params as { lang: string };
const { entry } = Astro.props as { entry: any };
const { Content } = await entry.render();
---
<BaseLayout title={entry.data.title} locale={lang}>
  <article class="section"><div class="container narrow">
    <h1>{entry.data.title}</h1>
    <div class="prose"><Content /></div>
  </div></article>
</BaseLayout>
<style>
  .narrow { max-width: 680px; margin-inline: auto; }
  h1 { font-size: clamp(24px, 3vw, 32px); margin-bottom: 18px; }
  .prose { font-size: 14px; line-height: 1.7; color: var(--color-ink); }
  .prose :global(p) { margin: 0 0 1em; }
  .prose :global(h2) { font-size: 18px; margin: 1.4em 0 .5em; }
</style>
