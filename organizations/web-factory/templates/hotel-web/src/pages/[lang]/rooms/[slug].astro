---
import site from "../../../config/site";
import { useT } from "../../../i18n";
import { byLocale, localePath } from "../../../lib/content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Image from "../../../components/primitives/Image.astro";
import Badge from "../../../components/primitives/Badge.astro";
import Button from "../../../components/primitives/Button.astro";
import BookingWidget from "../../../components/blocks/BookingWidget.astro";

export async function getStaticPaths() {
  if (site.pages?.roomDetail === false || site.pages?.rooms === false) return [];
  const paths: any[] = [];
  for (const lang of site.locales) {
    const rooms = await byLocale("rooms", lang);
    for (const r of rooms) paths.push({ params: { lang, slug: r.data.slug }, props: { room: r.data } });
  }
  return paths;
}
const { lang } = Astro.params as { lang: string };
const { room } = Astro.props as { room: any };
const t = useT(lang);
const cur = room.currency === "EUR" ? "€" : room.currency === "USD" ? "$" : room.currency + " ";
---
<BaseLayout title={room.name} locale={lang} hasBooking>
  <section class="section"><div class="container">
    <a class="back muted" href={localePath(lang, "rooms")}>← {t("nav.rooms")}</a>
    <h1>{room.name}</h1>
    <div class="hero"><Image src={room.image} alt={room.name} ratio="16/9" /></div>
    <div class="cols">
      <div class="main">
        {room.description && <p class="muted lead">{room.description}</p>}
        <div class="chips">
          {room.sizeM2 && <Badge>{room.sizeM2} m²</Badge>}
          {room.capacity && <Badge>{`${room.capacity} ${t("booking.guests")}`}</Badge>}
          {room.bed && <Badge>{room.bed}</Badge>}
          {room.view && <Badge>{room.view}</Badge>}
        </div>
        {room.amenities?.length > 0 && (
          <div class="amen"><h3>{t("nav.amenities")}</h3>
            <ul>{room.amenities.map((a: string) => <li>{a}</li>)}</ul>
          </div>
        )}
      </div>
      <aside class="side">
        {room.priceFrom != null && (
          <div class="price">{cur}{room.priceFrom}<span class="muted">{t("common.night")}</span></div>
        )}
        <BookingWidget locale={lang} vertical />
      </aside>
    </div>
  </div></section>
</BaseLayout>
<style>
  .back { display: inline-block; font-size: 12px; margin-bottom: 8px; }
  h1 { font-size: clamp(28px, 4vw, 40px); margin-bottom: 16px; }
  .hero { margin-bottom: 24px; }
  .cols { display: flex; gap: 40px; align-items: flex-start; }
  .main { flex: 1; display: flex; flex-direction: column; gap: 18px; }
  .lead { font-size: 15px; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .amen ul { columns: 2; margin: 8px 0 0; padding-left: 16px; font-size: 13px; color: var(--color-muted); }
  .side { width: 320px; flex-shrink: 0; border: 1px solid var(--color-line); border-radius: var(--radius); padding: 18px; display: flex; flex-direction: column; gap: 14px; }
  .price { font-family: var(--font-head); font-size: 26px; color: var(--color-accent); }
  .price span { font-family: var(--font-body); font-size: 13px; }
  @media (max-width: 720px) { .cols { flex-direction: column; } .side { width: 100%; } }
</style>
