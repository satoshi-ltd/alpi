Screen {
    background: $background;
    layers: base overlay;
}

AlpiTopBar {
    height: 2;
    background: $background;
    color: $text-muted;
    padding: 1 2 0 2;
}

AlpiHeader {
    height: 1;
    background: $background;
    color: $text-muted;
    padding: 0 2;
}

AssistantMessage MarkdownBullet {
    color: $text-muted;
}
AssistantMessage MarkdownBlock > .code_inline {
    background: transparent;
    color: $accent-darken-1;
    text-style: none;
}
AssistantMessage MarkdownHeader {
    background: transparent;
    border: none;
    margin: 1 0 0 0;
}

/* Textual can't size text — heading hierarchy uses weight + color. */
AssistantMessage MarkdownH1 {
    color: $accent;
    text-style: bold;
}
AssistantMessage MarkdownH2 {
    color: $accent;
    text-style: bold;
}
AssistantMessage MarkdownH3 {
    color: $foreground;
    text-style: bold;
}
AssistantMessage MarkdownH4 {
    color: $text-muted;
    text-style: bold;
}

AssistantMessage MarkdownFence {
    background: $surface;
    color: $foreground;
    padding: 1 2;
    margin: 1 0;
    border-left: thick $accent-darken-1;
}

AssistantMessage MarkdownBlockQuote {
    background: transparent;
    color: $text-muted;
    padding: 0 0 0 1;
    margin: 1 0;
    border-left: thick $text-muted;
}

AssistantMessage MarkdownTable {
    margin: 1 0;
}
AssistantMessage MarkdownTH {
    background: $surface;
    color: $foreground;
    text-style: bold;
}
AssistantMessage MarkdownTD {
    color: $foreground;
}

AssistantMessage MarkdownHorizontalRule {
    color: $text-muted;
    margin: 1 0;
}

AssistantMessage MarkdownOrderedListItem {
    color: $foreground;
}
AssistantMessage MarkdownUnorderedListItem {
    color: $foreground;
}

#chat {
    padding: 1 2;
    height: 1fr;
    scrollbar-size: 0 0;
}

UserMessage {
    color: $accent;
    text-style: bold;
    margin: 1 0 1 0;
    height: auto;
}

AssistantMessage {
    margin: 1 0 0 0;
    height: auto;
    background: transparent;
}

AssistantMessage > Markdown {
    background: transparent;
    padding: 0;
    margin: 0;
}

ErrorLine {
    color: $error;
    margin: 1 0 0 0;
    height: auto;
}

DimLine {
    color: $text-muted;
    margin: 0;
    height: auto;
}

ReasoningLine {
    color: $text-muted;
    margin: 1 0 0 0;
    padding: 0;
    height: auto;
}

ToolCard {
    height: 1;
    margin: 0;
    padding: 0;
}

ToolCard.-running {
    color: $foreground;
}

ToolCard.-done {
    color: $foreground;
}

ToolCard.-error {
    color: $error;
}

#chat-input {
    background: $surface;
    color: $foreground;
    border: none;
    padding: 1 2;
    height: 3;
    margin: 1 1;
    scrollbar-size-horizontal: 0;
}

#chat-input:focus {
    background-tint: $accent 15%;
}

OptionList > .option-list--option {
    color: $foreground;
    padding: 0 0;
    text-wrap: nowrap;
}

OptionList > .option-list--option-hover {
    background: $surface-lighten-1;
}

OptionList > .option-list--option-highlighted {
    background: $accent;
    color: $foreground;
    text-style: bold;
}
