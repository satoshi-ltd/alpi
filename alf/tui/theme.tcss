Screen {
    background: $background;
    layers: base overlay;
}

AlfTopBar {
    height: 2;
    background: $background;
    color: $text-muted;
    padding: 1 2 0 2;
}

AlfHeader {
    height: 1;
    background: $background;
    color: $text-muted;
    padding: 0 2;
}

AssistantMessage MarkdownBullet {
    color: $text-muted;
}
AssistantMessage MarkdownBlock > .code_inline {
    background: transparent;
    color: $accent-darken-1;
    text-style: none;
}
AssistantMessage MarkdownHeader {
    background: transparent;
    border: none;
}

#chat {
    padding: 1 2;
    height: 1fr;
    scrollbar-size: 0 0;
}

UserMessage {
    color: $accent;
    text-style: bold;
    margin: 1 0 1 0;
    height: auto;
}

AssistantMessage {
    margin: 1 0 0 0;
    height: auto;
    background: transparent;
}

AssistantMessage > Markdown {
    background: transparent;
    padding: 0;
    margin: 0;
}

ErrorLine {
    color: $error;
    margin: 0;
    height: auto;
}

DimLine {
    color: $text-muted;
    margin: 0;
    height: auto;
}

ReasoningLine {
    color: $text-muted;
    margin: 1 0 0 0;
    padding: 0;
    height: auto;
}

ToolCard {
    height: 1;
    margin: 0;
    padding: 0;
}

ToolCard.-running {
    color: $foreground;
}

ToolCard.-done {
    color: $foreground;
}

ToolCard.-error {
    color: $error;
}

#chat-input {
    background: $surface;
    color: $foreground;
    border: none;
    padding: 1 2;
    height: 3;
    margin: 1 1;
    scrollbar-size-horizontal: 0;
}

#chat-input:focus {
    background-tint: $accent 15%;
}

ModalScreen > Vertical {
    background: $surface;
    border: thick $accent;
    padding: 1 2;
    width: 90;
    max-width: 90%;
    height: auto;
    max-height: 80%;
}

ModalScreen .modal-title {
    color: $accent;
    text-style: bold;
    margin-bottom: 1;
}

ModalScreen .modal-hint {
    color: $text-muted;
    margin-top: 1;
}

ModalScreen OptionList {
    background: $surface;
    max-height: 24;
    height: auto;
}

ModalScreen OptionList > .option-list--option-hover {
    background: $surface-lighten-1;
}

ModalScreen OptionList > .option-list--option-highlighted {
    background: $accent;
    color: $foreground;
    text-style: bold;
}

ModalScreen Input {
    margin-top: 1;
    background: $surface-lighten-1;
}
